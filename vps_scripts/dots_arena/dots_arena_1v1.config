// dots_arena 1v1 — server config for the fair-duel Lua module.
//
// Derived from the official Legacy Competition 1on1 config (legacy1.config),
// with the ~60 lines of sv_cvar client restrictions left out: this is a duel
// mode people are meant to enjoy, not a match server that argues with your fov.
// If you want that strictness, copy the `command "sv_cvar ..."` block from
// configs/legacy1.config into the init section below.
//
// !!! IMPORTANT NOTE (inherited from legacy1.config) !!!
// Ensure all values are surrounded by quotes, the parser can't properly deal
// with negative values otherwise.
//
// ⛔ TWO RULES THIS FILE OBEYS, AND WHY — break either and the config silently
//    unloads itself in under a second:
//
//    1. `arena_hp` is `set`, NEVER `setl`. G_ConfigCheckLocked (g_config.c:516)
//       runs EVERY FRAME from G_RunFrame and compares every `setl` cvar against
//       its live value; the first player who types /arenahp changes it, and the
//       server answers "Config WAS UNLOADED DUE TO EXTERNAL MANIPULATION" and
//       forgets the whole config. It does not even restore the value.
//    2. `g_forcerespawn` is not mentioned at all. The module writes it (-1) at
//       every map load and restores it at shutdown, so a `setl` on it would
//       unload the config the moment the arena arms.
//
// ⛔ `map default` MUST STAY ABOVE `map dots_arena`, and must never set
//    lua_modules. G_ParseMapSettings (g_config.c:290) applies a `default`
//    block unconditionally — it does not check whether a specific block also
//    matched — so anything it sets overrides a map block placed above it.
//
// Tested on ET:Legacy v2.84.0. See README.md next to this file.

configname "^1Dots ^7Arena ^21v1"
// ⛔ ONE number for the bundle. This is shown to every player on a `cp` when
// the config loads (g_config.c:442) while lua_status shows the module's own
// VERSION — two visible numbers for one thing meant a bug report could not
// say which build it came from. Pinned by test_dots_arena_config_contract.
version "1.1.0"
public

init
{
	setl sv_pure "1"
	setl sv_cheats "0"
	setl sv_fps "40"
	setl sv_floodProtect "0"

	setl g_gameType "3"
	setl g_warmup "15"
	setl g_doWarmup "1"
	setl g_voiceChatsAllowed "100"
	setl g_spectatorInactivity "0"
	setl g_friendlyFire "1"
	setl g_heavyWeaponRestriction "0"
	setl g_medicChargeTime "45000"
	setl g_fieldopsChargeTime "40000"
	setl g_engineerChargeTime "30000"
	setl g_soldierChargeTime "30000"
	setl g_covertopschargetime "30000"
	setl g_stickyCharge "2"
	setl g_landminetimeout "0"
	setl g_dropAmmo "0"
	setl g_dropHealth "0"
	setl g_teamForceBalance "0"
	setl g_filtercams "1"
	setl g_fastres "0"
	setl g_noTeamSwitching "1"
	setl g_alliedmaxlives "0"
	setl g_axismaxlives "0"
	setl g_speed "320"
	setl g_gravity "800"
	setl g_knockback "1000"
	setl g_countryFlags "1"
	setl g_misc "0"
	setl g_skillrating "0"
	setl g_dropObjDelay "3000"

	setl team_maxSoldiers "0"
	setl team_maxMedics "0"
	setl team_maxEngineers "0"
	setl team_maxFieldops "-1"
	setl team_maxCovertops "0"

	setl team_maxFlamers "0"
	setl team_maxMachineguns "0"
	setl team_maxMortars "0"
	setl team_maxRockets "0"
	setl team_maxRiflegrenades "0"
	setl team_maxLandmines "0"

	setl team_maxAirstrikes "0.0"
	setl team_maxArtillery "0.0"

	setl team_riflegrenades "1"

	setl match_latejoin "1"
	setl match_minplayers "2"
	setl match_readypercent "100"
	setl match_timeoutcount "2"
	setl match_timeoutlength "90"

	// ⭐ NOT 0, and that matters more than it looks. G_Damage returns early
	// during warmup when this is 0 (g_combat.c:1445), so the module's forced
	// reset would neither happen NOR report anything — which reads exactly
	// like "the Lua is broken". legacy1.config already had this right.
	setl match_warmupDamage "2"

	setl team_maxplayers "0"
	setl team_nocontrols "0"

	setl sv_minping "0"
	setl sv_maxping "0"

	setl pmove_fixed "0"
	setl pmove_msec "8"

	set nextmap "map_restart 0"

	// ⛔ g_allowVote does NOT exist in ET:Legacy 2.84 — it is not in the cvar
	// table and nothing reads it; Cmd_CallVote_f gates on vote_allow_* and
	// vote_limit instead. Inherited from legacy1.config, kept only as this
	// note so nobody re-adds it believing it enables voting.
	setl vote_allow_balancedteams "0"
	setl vote_allow_config "1"
	setl vote_allow_friendlyfire "0"
	setl vote_allow_gametype "0"
	setl vote_allow_kick "1"
	setl vote_allow_map "1"
	setl vote_allow_matchreset "1"
	setl vote_allow_mutespecs "1"
	setl vote_allow_muting "1"
	setl vote_allow_nextmap "0"
	setl vote_allow_referee "1"
	setl vote_allow_shuffleteams "0"
	setl vote_allow_shuffleteams_norestart "0"
	setl vote_allow_surrender "0"
	setl vote_allow_swapteams "1"
	setl vote_allow_timelimit "1"
	setl vote_allow_warmupdamage "0"
	setl vote_allow_maprestart "1"
	setl vote_allow_cointoss "1"
	setl vote_allow_antilag "0"
	setl vote_limit "99"
	setl vote_percent "51"

	setl g_mapscriptdirectory "mapscripts"
	setl g_mapConfigs ""

	setl skill_battlesense "-1"
	setl skill_engineer "-1"
	setl skill_medic "-1"
	setl skill_fieldops "-1"
	setl skill_lightweapons "-1"
	setl skill_soldier "-1"
	setl skill_covertops "-1"

	setl g_intermissiontime "20"
	setl g_multiview "0"
	setl g_shove "0"
	setl g_shoveNoZ "1"
	setl g_antiwarp "1"
	setl g_maxWarp "4"
	setl g_antilag "1"
	setl g_realHead "1"
	setl g_fixedphysics "1"
	setl g_fixedphysicsfps "125"
	setl g_campaignfile ""

	setl g_pronedelay "3"

	// ⛔⛔ MERGE THIS LINE, DO NOT JUST TAKE IT. The config format has no
	// "append" — whatever stands here REPLACES your server's whole Lua module
	// list. If you already run wolfadmin or anything else, put it on this line
	// too, or it stops working the moment this config loads. Measured on a
	// server that had six modules: loading this config took it to one.
	//
	// ⭐ THIS LINE IS FOR YOUR MAPS, NOT FOR THE ARENA. The arena module is
	// named again in the `map dots_arena` block below, which overrides this on
	// that one map — so what belongs here is whatever YOUR server normally
	// runs. Left exactly as shipped it hands every map on your rotation to the
	// arena module alone.
	//
	// An earlier shape put the arena module here and nowhere else and leaned on
	// the module's own map gate to stay quiet elsewhere. That works, but it
	// still takes the admin's list away on every map to buy something the map
	// block gives for free.
	setl lua_modules "luascripts/dots_arena_1v1.lua"

	set g_log "dots_arena.log"
}

// ⛔ This block runs on EVERY map, including dots_arena — `default` is applied
// unconditionally (g_config.c:290-294), it does NOT check whether a specific
// block also matched. It must therefore come FIRST, so the map block below can
// override what it sets. It carries the ordinary respawn defaults; keeping the
// arena module out of other maps is the module's own job, not this block's.
map default
{
	// ⛔ Deliberately does NOT touch lua_modules. A `default` block is applied
	// unconditionally (g_config.c:290) — it does not check whether a specific
	// block matched — so clearing the module list here would disarm the arena
	// on its own map AND kill every other module the admin runs, on every map.
	set g_userTimeLimit "10"
	setl g_useralliedrespawntime "0"
	setl g_useraxisrespawntime "0"
	setl g_moverScale "1.0"
}

map dots_arena
{
	// ⭐ The module list, scoped to THIS map. `init` above runs on every map
	// load and this block overrides it only here, so a mixed-rotation server
	// keeps its own modules everywhere else — which the earlier shape, with
	// the arena module in `init` alone, took away on every map.
	// `setl` overwrites an existing entry by name (g_config.c:218-238), so the
	// locked list ends up with one consistent value and G_ConfigCheckLocked
	// has nothing to complain about.
	setl lua_modules "luascripts/dots_arena_1v1.lua"

	set arena_1v1 "1"
	set arena_1v1_map "dots_arena"
	set arena_1v1_log "1"
	set arena_1v1_test "0"

	// ⛔⛔ EVERY arena_* line in this block is `set`, never `setl`, and that is
	// not tidiness — it is the difference between a config that works and one
	// that destroys itself the first time somebody follows our own README.
	//
	// G_ConfigCheckLocked (g_config.c:516) re-reads every `setl` cvar once per
	// frame from G_RunFrame and unloads the WHOLE config the moment one of
	// them differs — without restoring it. The README documents all of these
	// as runtime knobs, and `/arenahp` writes arena_hp itself. A reader who
	// typed `arena_1v1 0` because we told them it stands the module down would
	// have got "Config WAS UNLOADED DUE TO EXTERNAL MANIPULATION" and lost the
	// whole ruleset with it. Eleven of the twelve were locked; we shipped it.
	set arena_hp "0"

	set arena_vamp "0"
	set arena_vamp_steal "50"
	set arena_vamp_grace "90"
	set arena_vamp_decay "30"
	set arena_ammo "1"
	set arena_nofatigue "1"

	// Measured against bots: the write lands but Omni-bot takes its weapon
	// back within seconds (held in 2 of 25 duels), and it costs ~1.5x the
	// ClientUserinfoChanged traffic. Useful with humans, pointless with bots.
	set arena_symmetric "0"

	set g_userTimeLimit "15"
	setl g_useralliedrespawntime "1"
	setl g_useraxisrespawntime "1"
	mapscripthash ""
}
