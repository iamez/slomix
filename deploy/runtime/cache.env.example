# Standalone DEV HTTP cache consumer; enable only after final acceptance.
BOT_ENVIRONMENT=dev
EVENT_STREAM_ENABLED=false
RUNTIME_HTTP_CACHE_EVENTS_ENABLED=false
RUNTIME_HTTP_CACHE_WORKER_ENABLED=false
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DATABASE=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=
RUNTIME_CACHE_DB_SCHEMA=public
