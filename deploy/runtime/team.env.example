# Copy OUTSIDE the release/Git tree, chmod 0600; fill the approved DEV target.
# Flags stay off until final acceptance and owner-controlled writer handover.
BOT_ENVIRONMENT=dev
EVENT_STREAM_ENABLED=false
RUNTIME_TEAM_EVENTS_ENABLED=false
RUNTIME_TEAM_WORKER_ENABLED=false
RUNTIME_TEAM_DEV_HANDOVER_CONFIRMED=false
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DATABASE=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=
