# ${APP_DIR}/website/logs was dropped on 2026-08-15: nothing has written there
# since 2026-02-19. Both services resolve their log directory to <repo>/logs
# (bot/logging_config.py and website/backend/logging_config.py both default to
# the repository root), so the second glob only kept a 76 MB fossil tree alive
# in every rotation run.
${APP_DIR}/logs/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    # logrotate runs as root by default and refuses to touch logs whose
    # parent directory is writable by a non-root group (setup_logging()
    # makes ${APP_DIR}/logs 0770, group ${SLX_GROUP}) unless told to act as
    # that user/group instead — the logrotate manual specifically
    # recommends `su` for directories "directly or indirectly in control of
    # non-privileged users". Without it, daily rotation silently no-ops on
    # every file here (Codex review on #568).
    su ${BOT_USER} ${SLX_GROUP}
    # 0660: the bot and web services run as different OS users sharing one
    # group (${BOT_USER}/${WEB_USER} in group ${SLX_GROUP}). 0640 leaves the
    # non-owning service with read-only access, which crash-looped the bot
    # in past incidents once the web service rotated/recreated a shared log
    # file (e.g. errors.log). See website/backend/logging_config.py for the
    # matching application-level fix.
    create 0660 ${BOT_USER} ${SLX_GROUP}
    sharedscripts
}
