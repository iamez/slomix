${APP_DIR}/logs/*.log ${APP_DIR}/website/logs/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    # 0660: the bot and web services run as different OS users sharing one
    # group (${BOT_USER}/${WEB_USER} in group ${SLX_GROUP}). 0640 leaves the
    # non-owning service with read-only access, which crash-looped the bot
    # in past incidents once the web service rotated/recreated a shared log
    # file (e.g. errors.log). See website/backend/logging_config.py for the
    # matching application-level fix.
    create 0660 ${BOT_USER} ${SLX_GROUP}
    sharedscripts
}
